[Unit]
Description=TrendVN host agent (Chrome collector and publisher API)
After=network-online.target docker.service

[Service]
WorkingDirectory=@ROOT@
Environment=PYTHONPATH=@ROOT@/services/agent/src
ExecStart=@ROOT@/.venv/bin/python -m trendvn_agent
Restart=always
RestartSec=15
Environment=PYTHONUNBUFFERED=1
@DISPLAYENV@
NoNewPrivileges=true

[Install]
WantedBy=default.target
