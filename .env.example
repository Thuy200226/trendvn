# TrendVN: configuration sample. Do not edit this file; `./trendvn install` creates real `.env` (permission 0600, not included in git). If you want to change any value, add that line to `.env`.
# All values below are optional except the two secret keys generated by ./trendvn install.

# --- Secret ------------------------------------------------------------------------
# ./trendvn install automatically generates the following two keys and writes them to .env (don't share, don't set empty values yourself):
#   N8N_ENCRYPTION_KEY encrypts authentication information in n8n; LOSS OF THIS KEY = loss of information saved in n8n
#   TRENDVN_TOKEN shared key between n8n, worker and agent
# .env reading rule (same as docker compose): lines starting with # are comments; at the end of the line, " # ..." is also a comment;
# If you want to preserve the # character or space in the value, put it in single quotes; The character $ in the value is written as $$.

# --- Project's private network (scripts/setup_env.py optionally selects unused range) ------------
TRENDVN_SUBNET=172.20.0.0/16
TRENDVN_GATEWAY=172.20.0.1   # agent on the server only listens at this address (does not expose LAN)
TRENDVN_AGENT_BIND=172.20.0.1
TRENDVN_AGENT_PORT=5682

# --- Project name and port -------------------------------------------------------
# Only change when running TWO versions of TrendVN on the same machine (each version needs a different name and all three ports, installed with --no-service).
# COMPOSE_PROJECT_NAME=trendvn
# TRENDVN_N8N_PORT=5680
# TRENDVN_WORKER_PORT=5681

# --- Time zone and access -------------------------------------------------------
TRENDVN_TZ=Asia/Ho_Chi_Minh
# By default, it only opens on this device. If you want access from another machine, SSH tunnel is preferred (see docs/DEPLOY.md).
# If forced to open directly: TRENDVN_BIND=0.0.0.0, include the lines below for the correct address you use.
TRENDVN_BIND=127.0.0.1
# TRENDVN_N8N_URL=http://may-chu:5680
# TRENDVN_N8N_HOST=may-chu
# TRENDVN_UI_HOSTS=may-chu:5681 # Hosts are allowed to open the control panel, separated by commas
# TRENDVN_UI_PASSWORD= # REQUIRED when opening the control panel outside the computer (set a long password). If not set, other Hosts will be rejected.
#                                    # On this machine itself (localhost) no password is needed.
# TRENDVN_UI_HTTPS=1 # set when there is a TLS proxy in front: login cookie is marked Secure
# TRENDVN_TRUSTED_PEERS= # only needed on Docker Desktop (macOS/Windows) if the console says "not this machine": connection source address from your own machine

# --- Poster ---------------------------------------------------------------
# Default: opens a real Chrome window when the device has a screen (TikTok is less challenging than hidden Chrome). Press by 1 or 0.
# TRENDVN_PUBLISH_HEADED=1

# --- Video processing ------------------------------------------------------------------
# TRENDVN_PROCESS_PARALLEL=2 # number of videos to process at the same time (1 = each video in turn; weak device should set to 1)

# --- American source (TikTok, Instagram): US IP required ---------------------------
# Without this line, two US sources are ignored (never mislabel Vietnamese content as US trend).
# TRENDVN_US_PROXY=http://user:pass@host:port # also accept socks5: //
# TRENDVN_CN_PROXY= # usually not needed

# --- Phone notification (or enter in console) --------------------
# TRENDVN_TELEGRAM_TOKEN=123456789:AA...
# TRENDVN_TELEGRAM_CHAT=-1001234567890
# TRENDVN_NOTIFY_WEBHOOK=https://discord.com/api/webhooks/...
# TRENDVN_NTFY_URL=https://ntfy.sh/ten-rieng-kho-doan
